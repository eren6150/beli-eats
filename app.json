{
  "expo": {
    "name": "Platestamp",
    "slug": "beli-eats",
    "scheme": "com.eren.platestamp",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eren.platestamp",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Platestamp, etrafındaki restoranları göstermek için konumuna ihtiyaç duyuyor.",
        "NSLocationAlwaysUsageDescription": "Platestamp, etrafındaki restoranları göstermek için konumuna ihtiyaç duyuyor."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5F7527"
      },
      "package": "com.eren.platestamp",
      "versionCode": 8,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-location",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Platestamp, mekan fotoğrafı paylaşabilmen için galerine erişmek istiyor.",
          "cameraPermission": "Platestamp, mekanda anında fotoğraf çekebilmen için kameranı kullanmak istiyor.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d77bc86b-c3e4-4f7b-8136-2a1e82c3c278"
      }
    },
    "owner": "eren6150"
  }
}
