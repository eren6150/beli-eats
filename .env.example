# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps / Places API
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# NOT: Places REST anahtari ARTIK ISTEMCIDE YOK (Asama 4).
# Google Places cagrilari google-places Edge Function uzerinden gidiyor ve
# anahtar yalnizca Supabase secret olarak duruyor:
#   npx supabase secrets set GOOGLE_PLACES_API_KEY=...

# hCaptcha (bot koruması) — SITE anahtarı, gizli DEĞİL ve bundle'a gömülüyor.
# Gizli olan SECRET anahtar; o yalnızca Supabase paneline girilir, buraya ASLA.
# Geliştirme için hCaptcha'nın herkese açık test anahtarı kullanılabilir:
#   10000000-ffff-ffff-ffff-000000000001
# ⚠️ EAS build'i bu değeri .env'den OKUMAZ — expo.dev > Environment variables
# altında preview ve production ortamlarına ayrıca eklenmeli (bkz. §5.2).
EXPO_PUBLIC_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key-here